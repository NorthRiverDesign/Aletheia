APP_NAME=Aletheia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# # DB_HOST=127.0.0.1
# # DB_PORT=3306
# # DB_DATABASE=laravel
# # DB_USERNAME=root
# # DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Request throttling, per member or per IP for guests; 0 disables a limit
THROTTLE_READS_PER_MINUTE=300
THROTTLE_WRITES_PER_MINUTE=60
THROTTLE_REGISTRATIONS_PER_HOUR=5
THROTTLE_PASSWORD_RESETS_PER_HOUR=10
THROTTLE_SUGGESTIONS_PER_HOUR=20

# AI analysis of vectors against targets (runs on the queue worker)
# Provider: anthropic (Claude) or xai (Grok)
AI_PROVIDER=anthropic
# Hours before the same vector/target pair can be analyzed again; 0 disables
ANALYSIS_COOLDOWN_HOURS=168
# Fact-check every new finding with a second AI pass as soon as its analysis completes
VERIFY_FINDINGS_AUTOMATICALLY=false

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high
ANTHROPIC_MAX_TOKENS=16000
# Web searches allowed per analysis; 0 disables web search
ANTHROPIC_WEB_SEARCH_MAX_USES=5
# Pages a fact check may open to read a finding's cited sources; 0 disables web fetch
ANTHROPIC_WEB_FETCH_MAX_USES=10
ANTHROPIC_FALLBACKS=true

XAI_API_KEY=
XAI_MODEL=grok-4.3
XAI_REASONING_EFFORT=
XAI_MAX_OUTPUT_TOKENS=16000
# Agentic turns (web searches) allowed per request; 0 leaves it to xAI
XAI_MAX_TURNS=8
XAI_WEB_SEARCH=true

VITE_APP_NAME="${APP_NAME}"
